# TTGO Chat Controller Bridge — environment variables
# Copy to .env (or add to ~/.hermes/.env) and fill in real values.

# ── Hermes API server (OpenAI-compatible) ───────────────────────────────────
# The bridge talks to Hermes' API server. HERMES_API_KEY must match the
# API_SERVER_KEY the server is started with (see README "Hermes API server").
HERMES_API_KEY=
HERMES_API_BASE=http://localhost:8642
HERMES_API_MODEL=hermes-agent

# ── Hermes repo (for STT/TTS) ───────────────────────────────────────────────
# Absolute path to the hermes-agent checkout. The bridge imports
# tools.transcription_tools and tools.tts_tool from it, so STT and TTS use the
# providers/voice configured in ~/.hermes/config.yaml (no keys/voice here).
# Optional if this repo lives inside the checkout (…/hermes-agent/ttgo-chat/).
# HERMES_AGENT_ROOT=/home/youruser/.hermes/hermes-agent

# ── Serial ──────────────────────────────────────────────────────────────────
TTGO_CHAT_PORT=/dev/ttyACM0
TTGO_CHAT_BAUD=115200
# TTGO_CHAT_USB_SERIAL=537A038767   # Optional: autodetect port by USB serial ID

# ── Audio ───────────────────────────────────────────────────────────────────
# There is NO audio config here. Capture and playback follow the system default
# source/sink via PipeWire (pw-record / pw-play), and loudness is the system
# volume (wpctl set-volume @DEFAULT_AUDIO_SINK@ … / the desktop slider).
# Select your mic/speaker as the system defaults; the bridge follows them.

# ── Display ─────────────────────────────────────────────────────────────────
# Context window size for the % bar. Match your model (Claude/DeepSeek ~200k, GPT-4o ~128k, etc.)
CTX_WINDOW_TOKENS=200000
